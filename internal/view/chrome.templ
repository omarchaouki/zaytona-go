package view

import (
	"github.com/omarchaouki/zaytona-go/internal/domain"
	"github.com/omarchaouki/zaytona-go/internal/i18n"
)

// WALink is an anchor to wa.me with the number from Settings. It renders
// nothing when no number is set, so a missing setting never makes a broken
// link. Clicks are counted (anonymously) through data-wa-placement.
templ WALink(p Page, placement, text, class, ariaLabel string) {
	if href := p.WAHref(text); href != "" {
		<a
			href={ templ.SafeURL(href) }
			target="_blank"
			rel="noopener noreferrer"
			data-wa-placement={ placement }
			class={ class }
			if ariaLabel != "" {
				aria-label={ ariaLabel }
			}
		>
			{ children... }
		</a>
	}
}

const footerLink = "tap inline-flex items-center gap-2 text-limewash/90 underline-offset-[6px] decoration-2 decoration-oil-bright transition-colors hover:text-limewash hover:underline"

const footerHeading = "text-step-small font-semibold text-olive-400"

// SiteFooter: the close of every public page, on dark olive with the olive
// texture. The mill and its authorisation with the two ways to order, then
// how to reach it, where it is, and the legal links; its name runs large
// behind the last line.
templ SiteFooter(p Page) {
	<footer class="olive-texture-dark relative overflow-hidden rounded-t-[2.5rem] bg-olive-950 text-limewash">
		<div class="container-page relative z-10 pt-16 pb-8 md:pt-20">
			<div class="grid gap-12 md:grid-cols-2 lg:grid-cols-[minmax(0,1.4fr)_repeat(3,minmax(0,1fr))] lg:gap-10">
				<div data-reveal>
					<p class="text-step-lead font-medium">{ p.SiteName() }</p>
					<p class="text-olive-200">{ p.T(i18n.BrandPlace) }</p>
					<p class="mt-5 max-w-[34ch] text-limewash/85">{ p.T(i18n.HeroSubtitle) }</p>
					if p.ONSSANumber != "" {
						<p class="mt-5 inline-flex items-center gap-2 rounded-full bg-limewash/10 px-3.5 py-1.5 text-step-small text-olive-200">
							@IconShieldCheck("size-4 text-oil-bright")
							{ p.T(i18n.FooterOnssa, "number", p.ONSSANumber) }
						</p>
					}
					<div class="mt-7 flex flex-wrap items-center gap-3">
						<a href={ templ.SafeURL(p.SectionHref("#order")) } class={ btn("md"), "btn-press inline-flex bg-oil-bright text-olive-950 hover:bg-oil" }>
							{ p.T(i18n.NavOrderNow) }
							@IconArrowForward("")
						</a>
						@WALink(p, "footer", "", "btn-press inline-flex size-11 items-center justify-center rounded-full bg-whatsapp text-whatsapp-ink transition-transform hover:scale-105", p.T(i18n.WhatsappFloatingLabel)) {
							@WhatsAppIcon("size-5")
						}
					</div>
				</div>
				if footerHasContact(p) {
					<div data-reveal class="stagger-10">
						<h2 class={ footerHeading }>{ p.T(i18n.FooterContact) }</h2>
						<ul class="mt-3 space-y-0.5">
							for _, phone := range p.Settings.Contact.Phones {
								<li>
									<a href={ templ.SafeURL("tel:" + phone) } class={ footerLink }>
										@IconPhone("size-4 text-olive-400")
										<span class="sr-only">{ p.T(i18n.FooterPhone) }: </span>
										<span dir="ltr">{ domain.FormatPhoneDisplay(phone) }</span>
									</a>
								</li>
							}
							if p.WAHref("") != "" {
								<li>
									@WALink(p, "footer", "", footerLink, "") {
										@WhatsAppIcon("size-4 text-olive-400")
										{ p.T(i18n.FooterWhatsapp) }
									}
								</li>
							}
							if e := p.Settings.Contact.Email; e != "" {
								<li>
									<a href={ templ.SafeURL("mailto:" + e) } class={ footerLink } dir="ltr">{ e }</a>
								</li>
							}
						</ul>
						if p.Hours() != "" {
							<p class="mt-4 flex items-start gap-2 text-step-small text-limewash/85">
								@IconClock("mt-0.5 size-4 shrink-0 text-olive-400")
								<span>{ p.Hours() }</span>
							</p>
						}
					</div>
				}
				<div data-reveal class="stagger-20">
					<h2 class={ footerHeading }>{ p.T(i18n.FooterAddress) }</h2>
					if p.Address() != "" {
						<p class="mt-3 flex items-start gap-2 text-limewash/90">
							@IconMapPin("mt-1 size-4 shrink-0 text-olive-400")
							<span class="whitespace-pre-line">{ p.Address() }</span>
						</p>
					} else {
						<p class="mt-3 text-limewash/90">{ p.T(i18n.BrandPlace) }</p>
					}
					if u := p.Settings.Contact.MapURL; u != "" {
						<a href={ templ.SafeURL(u) } target="_blank" rel="noopener noreferrer" class={ footerLink, "underline" }>{ p.T(i18n.FooterOpenMap) }</a>
					}
					if u := p.Settings.Contact.MapEmbedURL; u != "" {
						// The map iframe is heavy: loaded only when asked (landing.js);
						// without JS the button is a plain link to the map.
						<a href={ templ.SafeURL(u) } target="_blank" rel="noopener noreferrer" data-map-reveal data-map-title={ p.T(i18n.FooterMapTitle) } class={ footerLink, "underline" }>
							{ p.T(i18n.FooterShowMap) }
						</a>
					}
					if socials := p.Socials(); len(socials) > 0 {
						<h2 class={ footerHeading, "mt-6" }>{ p.T(i18n.FooterFollow) }</h2>
						<ul class="mt-2 flex flex-wrap gap-2">
							for _, s := range socials {
								<li><a href={ templ.SafeURL(s.URL) } target="_blank" rel="noopener noreferrer" class="tap inline-flex items-center rounded-full bg-limewash/10 px-4 text-step-small transition-colors hover:bg-limewash/20">{ s.Label }</a></li>
							}
						</ul>
					}
				</div>
				<nav data-reveal aria-label={ p.T(i18n.FooterLegal) } class="stagger-30">
					<h2 class={ footerHeading }>{ p.T(i18n.FooterLegal) }</h2>
					<ul class="mt-3 space-y-0.5">
						<li><a href={ templ.SafeURL(p.LocalHref("/privacy")) } class={ footerLink }>{ p.T(i18n.FooterPrivacy) }</a></li>
						<li><a href={ templ.SafeURL(p.LocalHref("/terms")) } class={ footerLink }>{ p.T(i18n.FooterTerms) }</a></li>
						<li>
							<a href={ templ.SafeURL(p.SwitchHref) } hreflang={ string(p.Locale.Other()) } lang={ p.Locale.Other().Meta().HTMLLang } class={ footerLink }>
								{ p.T(i18n.NavSwitchTo) }
							</a>
						</li>
					</ul>
				</nav>
			</div>
			<p aria-hidden="true" class="footer-name mt-16 font-display leading-[0.9] font-medium tracking-[-0.04em] text-olive-400/20 md:mt-20">{ p.SiteName() }</p>
			<div class="mt-6 flex flex-wrap items-center justify-between gap-x-6 gap-y-2 text-step-small text-limewash/70">
				<p>{ p.T(i18n.FooterRights, "year", yearString(p.Year), "name", p.SiteName()) }</p>
				<p>{ p.T(i18n.BrandPlace) }</p>
			</div>
		</div>
		<div aria-hidden="true" class="h-[calc(var(--mobile-bar-h)+env(safe-area-inset-bottom))]"></div>
	</footer>
}

// MobileOrderBar: phone-only sticky bar (Order + WhatsApp). landing.js shows it
// once the hero buttons scroll away, hides it while #order is on screen, and
// sets html[data-mobile-bar] so the footer makes room.
templ MobileOrderBar(p Page) {
	<div data-mobile-bar aria-hidden="true" inert class="fixed inset-x-0 bottom-0 z-40 translate-y-full rounded-t-3xl bg-paper px-4 pt-3 pb-[calc(0.75rem+env(safe-area-inset-bottom))] shadow-float transition-transform duration-300 data-[visible]:translate-y-0 md:hidden">
		<div class="flex gap-3">
			<a href="#order" class={ btn("md"), actPrimary, "flex-1" }>{ p.T(i18n.MobileBarOrder) }</a>
			@WALink(p, "mobile_bar", "", btn("md", "px-4")+" btn-press inline-flex bg-whatsapp text-whatsapp-ink", "") {
				@WhatsAppIcon("")
				{ p.T(i18n.MobileBarWhatsapp) }
			}
		</div>
	</div>
}

// FloatingWhatsApp: bottom-end from tablets up (phones have the sticky bar).
// The tooltip is shown once per session by landing.js.
templ FloatingWhatsApp(p Page) {
	if p.WAHref("") != "" {
		<div class="floating-wa fixed end-6 z-40 hidden flex-col items-end gap-2 md:flex">
			<div data-wa-tooltip role="status" hidden class="flex max-w-[15rem] items-start gap-2 rounded-2xl bg-paper py-2.5 ps-3.5 pe-1.5 text-sm text-ink shadow-float">
				<span class="pt-0.5">{ p.T(i18n.WhatsappTooltip) }</span>
				<button type="button" data-wa-tooltip-close class="inline-flex size-11 shrink-0 items-center justify-center rounded-full text-ink-soft hover:bg-sand" aria-label={ p.T(i18n.WhatsappTooltipClose) }>
					@IconX("size-4")
				</button>
			</div>
			@WALink(p, "floating", "", "floating-wa-button flex size-14 items-center justify-center rounded-full bg-whatsapp text-whatsapp-ink transition-transform hover:scale-105", p.T(i18n.WhatsappFloatingLabel)) {
				@WhatsAppIcon("size-7")
			}
		</div>
	}
}

// footerHasContact: the contact column shows only with something in it.
func footerHasContact(p Page) bool {
	c := p.Settings.Contact
	return len(c.Phones) > 0 || c.Email != "" || p.WAHref("") != "" || p.Hours() != ""
}
