package view

// Icons are inline SVG (Lucide geometry, same as the reference), decorative by default.

templ ArchMark(class string) {
	<svg viewBox="0 0 20 28" aria-hidden="true" focusable="false" class={ class }>
		<path d="M2.4 28V14.6A8.6 8.6 0 1 1 17.6 14.6V28Z" class="fill-olive-400"></path>
		<path d="M6 28v-9.5a4 4 0 0 1 8 0V28Z" class="fill-oil"></path>
	</svg>
}

templ WhatsAppIcon(class string) {
	<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false" class={ class }>
		<path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.23 8.23 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.83 2.42a8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.17c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.15.16-.29.18-.54.06a6.73 6.73 0 0 1-3.37-2.95c-.25-.44.25-.41.72-1.36.08-.16.04-.31-.02-.43-.06-.13-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.42h-.48a.92.92 0 0 0-.66.31c-.23.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.24 3.74 1.57.68 2.19.74 2.98.62.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.14-1.18-.06-.11-.22-.17-.47-.29Z"></path>
	</svg>
}

templ lucide(class string) {
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class={ class }>
		{ children... }
	</svg>
}

templ IconBanknote(class string) {
	@lucide(class) {
		<rect width="20" height="12" x="2" y="6" rx="2"></rect>
		<circle cx="12" cy="12" r="2"></circle>
		<path d="M6 12h.01M18 12h.01"></path>
	}
}

