// IconArrowForward points in the reading direction (left in Arabic).
templ IconArrowForward(class string) {
	@lucide(class + " rtl:-scale-x-100") {
		<path d="M5 12h14"></path>
		<path d="m12 5 7 7-7 7"></path>
	}
}

