package view

import "github.com/omarchaouki/zaytona-go/internal/i18n"

// Input renders a labelled input or textarea with its hint and error.
// prefix keeps ids unique when the same form appears several times.
templ Input(prefix string, f Field, value string, s *FormState) {
	<div class={ f.Class }>
		<label for={ f.id(prefix) } class="mb-1.5 block font-medium text-olive">{ f.Label }</label>
		if f.Rows > 0 {
			<textarea
				id={ f.id(prefix) }
				name={ f.Name }
				rows={ maxAttr(f.Rows) }
				if f.Max > 0 {
					maxlength={ maxAttr(f.Max) }
				}
				if f.Dir != "" {
					dir={ f.Dir }
				}
				required?={ f.Required }
				aria-invalid?={ s.E(f.Name) != "" }
				if f.Hint != "" || s.E(f.Name) != "" {
					aria-describedby={ f.id(prefix) + "-msg" }
				}
				class="field-input py-3"
			>{ s.V(f.Name, value) }</textarea>
		} else {
			<input
				id={ f.id(prefix) }
				name={ f.Name }
				type={ f.inputType() }
				value={ s.V(f.Name, value) }
				if f.Max > 0 {
					maxlength={ maxAttr(f.Max) }
				}
				if f.Dir != "" {
					dir={ f.Dir }
				}
				if f.Mode != "" {
					inputmode={ f.Mode }
				}
				if f.Placeholder != "" {
					placeholder={ f.Placeholder }
				}
				required?={ f.Required }
				aria-invalid?={ s.E(f.Name) != "" }
				if f.Hint != "" || s.E(f.Name) != "" {
					aria-describedby={ f.id(prefix) + "-msg" }
				}
				class="field-input min-h-11"
			/>
		}
		if s.E(f.Name) != "" || f.Hint != "" {
			<div id={ f.id(prefix) + "-msg" }>
				if s.E(f.Name) != "" {
					<p class="mt-1.5 text-sm font-medium text-danger">{ s.E(f.Name) }</p>
				}
				if f.Hint != "" {
					<p class="mt-1.5 text-sm text-ink-soft">{ f.Hint }</p>
				}
			</div>
		}
	</div>
}

templ Checkbox(name, label string, checked bool, class string) {
	<label class={ "flex min-h-11 cursor-pointer items-center gap-2", class }>
		<input type="checkbox" name={ name } value="1" checked?={ checked } class="size-5 shrink-0 accent-olive"/>
		<span class="font-medium">{ label }</span>
	</label>
}

// PhotoInput is the optional image file field (accept list lets iOS convert HEIC).
templ PhotoInput(p AdminPage, prefix, name, label, hint, errMsg string) {
	<div>
		<label for={ prefix + "-" + name } class="mb-1.5 block font-medium text-olive">{ label }</label>
		<input id={ prefix + "-" + name } type="file" name={ name } accept="image/jpeg,image/png,image/webp" aria-describedby={ prefix + "-" + name + "-msg" } class="block w-full min-h-11 rounded-field border border-sand-deep bg-white p-2 text-sm file:me-3 file:min-h-10 file:rounded-full file:border-0 file:bg-olive file:px-4 file:text-limewash"/>
		<div id={ prefix + "-" + name + "-msg" }>
			if errMsg != "" {
				<p class="mt-1.5 text-sm font-medium text-danger">{ errMsg }</p>
			}
			<p class="mt-1.5 text-sm text-ink-soft">{ hint }</p>
		</div>
	</div>
}

// SaveRow is the submit button (owners only) with the form error.
templ SaveRow(p AdminPage, label, errMsg, busy string) {
	if errMsg != "" {
		<p role="alert" class="text-sm font-medium text-danger">{ errMsg }</p>
	}
	if p.Owner {
		<div>
			<button
				type="submit"
				if busy != "" {
					data-busy-label={ busy }
				}
				class={ btn("md"), "inline-flex w-full bg-olive text-limewash hover:bg-olive-hover sm:w-auto" }
			>{ label }</button>
		</div>
	}
}

// OwnerNote tells staff why the fields are read-only.
templ OwnerNote(p AdminPage) {
	if !p.Owner {
		<p class="mt-g1 text-sm font-medium text-oil-deep">{ p.T(i18n.AdminCommonOwnerOnly) }</p>
	}
}

// DeleteButton posts action with confirm=0; with JS the dialog asks first,
// without JS the server shows a confirmation page.
templ DeleteButton(p AdminPage, action, label, dialog string) {
	<form method="post" action={ templ.SafeURL(action) }>
		@csrfField(p)
		<input type="hidden" name="confirm" value="0" data-confirm-field/>
		<button type="submit" data-confirm={ dialog } aria-label={ label } title={ label } class="tap inline-flex shrink-0 items-center justify-center rounded-full text-ink-soft transition-colors hover:bg-danger/10 hover:text-danger">
			@IconTrash("size-5")
		</button>
	</form>
}

// MoveButtons reorder an item (up/down), plain posts.
templ MoveButtons(p AdminPage, action, item string, first, last bool) {
	<div class="flex shrink-0 flex-col">
		<form method="post" action={ templ.SafeURL(action) }>
			@csrfField(p)
			<input type="hidden" name="dir" value="up"/>
			<button type="submit" disabled?={ first } aria-label={ p.T(i18n.AdminCommonMoveUp, "item", item) } title={ p.T(i18n.AdminCommonMoveUp, "item", item) } class="tap inline-flex items-center justify-center rounded-full text-olive hover:bg-sand disabled:opacity-30">
				@IconChevronDown("size-5 rotate-180")
			</button>
		</form>
		<form method="post" action={ templ.SafeURL(action) }>
			@csrfField(p)
			<input type="hidden" name="dir" value="down"/>
			<button type="submit" disabled?={ last } aria-label={ p.T(i18n.AdminCommonMoveDown, "item", item) } title={ p.T(i18n.AdminCommonMoveDown, "item", item) } class="tap inline-flex items-center justify-center rounded-full text-olive hover:bg-sand disabled:opacity-30">
				@IconChevronDown("size-5")
			</button>
		</form>
	</div>
}

// ConfirmDialog is a generic delete confirmation (JS).
templ ConfirmDialog(p AdminPage, id, title, body string) {
	<dialog id={ id } aria-labelledby={ id + "-title" } class="fixed inset-x-0 top-auto bottom-0 m-0 w-full max-w-none rounded-t-[24px] bg-limewash p-g3 pb-[calc(1.618rem+env(safe-area-inset-bottom))] shadow-lift backdrop:bg-ink/60 backdrop:backdrop-blur-sm sm:inset-0 sm:m-auto sm:h-fit sm:max-w-[28rem] sm:rounded-[24px]">
		<span class="flex size-12 items-center justify-center rounded-full bg-danger/10 text-danger">
			@IconTrash("size-6")
		</span>
		<h2 id={ id + "-title" } class="mt-g2 font-display text-h3 text-olive">{ title }</h2>
		<p class="mt-g1 text-sm text-ink-soft">{ body }</p>
		<div class="mt-g3 flex flex-col-reverse gap-g1 sm:flex-row sm:justify-end">
			<form method="dialog">
				<button autofocus class={ btn("md"), "inline-flex w-full border border-olive/30 text-olive hover:bg-olive/5" }>{ p.T(i18n.AdminCommonCancel) }</button>
			</form>
			<button type="button" data-confirm-yes class={ btn("md"), "inline-flex bg-danger text-white hover:bg-danger/90" }>
				@IconTrash("")
				{ p.T(i18n.AdminCommonDelete) }
			</button>
		</div>
	</dialog>
}

// AdminConfirm is the confirmation page used without JS: it posts the same
// action again with confirm=1 and the given hidden fields.
templ AdminConfirm(p AdminPage, action, title, body, back string, hidden map[string]string) {
	@AdminShell(p) {
		<form method="post" action={ templ.SafeURL(action) } class="max-w-md rounded-card bg-white p-g3 shadow-lift">
			@csrfField(p)
			<input type="hidden" name="confirm" value="1"/>
			for k, v := range hidden {
				<input type="hidden" name={ k } value={ v }/>
			}
			<span class="flex size-12 items-center justify-center rounded-full bg-danger/10 text-danger">
				@IconTrash("size-6")
			</span>
			<h1 class="mt-g2 font-display text-h3 text-olive">{ title }</h1>
			<p class="mt-g1 text-sm text-ink-soft">{ body }</p>
			<div class="mt-g3 flex flex-col-reverse gap-g1 sm:flex-row sm:justify-end">
				<a href={ templ.SafeURL(back) } class={ btn("md"), "inline-flex border border-olive/30 text-olive hover:bg-olive/5" }>{ p.T(i18n.AdminCommonCancel) }</a>
				<button type="submit" class={ btn("md"), "inline-flex bg-danger text-white hover:bg-danger/90" }>
					@IconTrash("")
					{ p.T(i18n.AdminCommonDelete) }
				</button>
			</div>
		</form>
	}
}

// ReauthCard asks for the password before sensitive changes (back to next).
templ ReauthCard(p AdminPage, next, errMsg string) {
	<form method="post" action="/admin/security/reauth" class="rounded-card border border-oil bg-oil-soft/50 p-g2 sm:p-g3">
		@csrfField(p)
		<input type="hidden" name="next" value={ next }/>
		<input type="email" name="username" autocomplete="username" value={ p.Email } readonly hidden/>
		<h2 class="font-bold text-olive">{ p.T(i18n.AdminSecurityReauthTitle) }</h2>
		<p class="mt-1 text-sm text-ink">{ p.T(i18n.AdminCommonReauthFirst) }</p>
		<div class="mt-3">
			@fieldLabel("reauth-"+next, p.T(i18n.AdminLoginPassword))
			<input id={ "reauth-" + next } name="password" type="password" autocomplete="current-password" dir="ltr" required maxlength="128" class="field-input"/>
		</div>
		@formError(errMsg)
		<button type="submit" class={ btn("md"), "mt-3 inline-flex bg-olive text-limewash hover:bg-olive-hover" }>{ p.T(i18n.AdminSecurityReauthSubmit) }</button>
	</form>
}
