// IconChevronNext points to the reading direction (flipped in RTL).
templ IconChevronNext(class string) {
	@lucide(class + " rtl:-scale-x-100") {
		<path d="m9 18 6-6-6-6"></path>
	}
}

// IconChevronPrev points against the reading direction (flipped in RTL).
templ IconChevronPrev(class string) {
	@lucide(class + " rtl:-scale-x-100") {
		<path d="m15 18-6-6 6-6"></path>
	}
}

templ IconChevronDown(class string) {
	@lucide(class) {
		<path d="m6 9 6 6 6-6"></path>
	}
}

