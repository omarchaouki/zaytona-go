# Copy to .env and fill in. Never commit .env.
# Variable names follow the reference app (../zaytona/.env.example) so the same
# production .env works for both apps during the cutover. If the reference has a
# variable that is missing here, port it with the same name.

# development | production. The release binary defaults to production rules
# (Secure cookie, real APP_SECRET required) when this is unset.
APP_ENV=development
PORT=3000
LOG_LEVEL=info

# Postgres. Docker: postgres://olive:olive@localhost:5432/olive
# task db:local (embedded): postgres://postgres:postgres@127.0.0.1:5434/postgres
DATABASE_URL=postgres://olive:olive@localhost:5432/olive
DATABASE_POOL_MAX=10

# >= 32 random bytes as hex: openssl rand -hex 32
# MUST be the same value as the TypeScript app in production, otherwise phone/IP
# hashes change and verified-review badges break. The example value is refused
# outside development.
APP_SECRET=change-me-change-me-change-me-change-me-change-me-0000

# Public origin for canonical URLs, hreflang, sitemap, Open Graph
SITE_URL=http://localhost:3000

# First owner account (created by `zaytona seed`, password change forced at first login)
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=

# Uploads (review photos, certificate scans)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# Optional new-order email (sent only if a recipient is set in Admin > Settings)
SMTP_URL=
NOTIFY_EMAIL_FROM=

# Optional new-order webhook (HTTPS only in production; Settings value wins)
ORDER_WEBHOOK_URL=

# Optional Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# true only behind your own reverse proxy (Caddy/nginx), so rate limits see the real IP
TRUST_PROXY=false

# Development only, refused in production
SEED_WHATSAPP_NUMBER=

# Optional privacy-friendly analytics: copy the exact ANALYTICS_* names from the reference
UMAMI_WEBSITE_ID=
